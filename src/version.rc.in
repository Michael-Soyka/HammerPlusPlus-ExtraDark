#include <winver.h>
#include "hppxdark_version.h"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION		HPPXDARK_VERSION_MAJOR,HPPXDARK_VERSION_MINOR,HPPXDARK_VERSION_BUILD,HPPXDARK_VERSION_REVISION
	PRODUCTVERSION	HPPXDARK_VERSION_MAJOR,HPPXDARK_VERSION_MINOR,HPPXDARK_VERSION_BUILD,HPPXDARK_VERSION_REVISION
	FILEFLAGSMASK	VS_FFI_FILEFLAGSMASK
	FILEFLAGS		0
	FILEOS			VOS_NT_WINDOWS32
	FILETYPE		@HPPXDARK_FILE_TYPE@
	FILESUBTYPE		0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",		"Michael Soyka"
			VALUE "FileDescription",	"@HPPXDARK_FILE_DESCRIPTION@"
			VALUE "FileVersion",		HPPXDARK_VERSION_TEXT
			VALUE "InternalName",		"@HPPXDARK_FILE_NAME@"
			VALUE "LegalCopyright",		"Copyright 2026 Michael Soyka"
			VALUE "OriginalFilename",	"@HPPXDARK_FILE_NAME@"
			VALUE "ProductName",		"Hammer++ Extra Dark"
			VALUE "ProductVersion",		HPPXDARK_PRODUCT_VERSION
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
